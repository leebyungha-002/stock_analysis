# 텔레그램 봇 설정
# 1. @BotFather 에서 봇 생성 후 토큰 복사
# 2. 봇에게 메시지를 먼저 보낸 뒤 Chat ID 확인:
#    https://api.telegram.org/bot<TOKEN>/getUpdates
#    → result[0].message.chat.id 값 복사
TELEGRAM_BOT_TOKEN=여기에_봇_토큰_입력
TELEGRAM_CHAT_ID=여기에_채팅_ID_입력

# 키움증권 REST API 설정
# 1. https://openapi.kiwoom.com 에서 API 사용신청 후 앱키/시크릿 발급
# 2. mock(모의투자) 또는 real(실전투자)
KIWOOM_MODE=mock
KIWOOM_APP_KEY=여기에_앱키_입력
KIWOOM_APP_SECRET=여기에_시크릿_입력
ACCOUNT_NO=여기에_계좌번호_입력
